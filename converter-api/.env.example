MAX_UPLOAD_BYTES=1073741824
CONVERSION_TIMEOUT_SECONDS=600
MAX_CONCURRENT_JOBS=1
DOWNLOAD_LINK_TTL_SECONDS=900
CONVERTER_TMP_ROOT=/var/lib/wechat-converter/tmp
CORS_ALLOW_ORIGINS=*
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=wechat_converter
MYSQL_USER=wechat_converter
MYSQL_PASSWORD=replace-with-a-strong-password

# Private Windows helper queue (docs/decisions/004-helper-protocol.md).
# The entire /api/v1/helper surface returns 503 while this is empty, so the
# default deployment never exposes an unauthenticated work queue.  Generate a
# long random value, e.g.  python -c "import secrets;print(secrets.token_urlsafe(48))"
# and give the same value to the helper via HELPER_ENROLLMENT_SECRET.
HELPER_ENROLLMENT_SECRET=
HELPER_LEASE_SECONDS=900
HELPER_MAX_ATTEMPTS=3
HELPER_TOKEN_TTL_DAYS=90
HELPER_HEARTBEAT_SECONDS=60
HELPER_MAX_SOURCE_BYTES=1073741824
HELPER_MAX_RESULT_BYTES=1073741824
HELPER_SOURCE_TTL_SECONDS=604800
