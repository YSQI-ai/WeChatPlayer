# Copy this file to .env (same directory) before running "docker compose up".
#
#   cp .env.example .env
#
# Compose reads .env automatically.  The real .env is git-ignored, so the values
# below are placeholders -- replace them, especially the passwords.

# --- Database credentials -------------------------------------------------
MYSQL_DATABASE=wechat_converter
MYSQL_USER=wechat_converter
MYSQL_PASSWORD=change-me-local-dev-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# --- Optional: private helper queue ---------------------------------------
# Left empty, the whole /api/v1/helper surface returns 503 and no work queue is
# exposed.  Generate a value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# and give the same value to the Windows helper via HELPER_ENROLLMENT_SECRET.
# HELPER_ENROLLMENT_SECRET=
