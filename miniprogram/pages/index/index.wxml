<view class="page-shell">
  <block wx:if="{{activeTab === 'workspace'}}">
  <view class="ambient ambient-one"></view><view class="ambient ambient-two"></view>
  <view class="top-status entrance entrance-1"><view class="top-brand"><view class="brand-orb">W</view><view><text class="brand-title">WECHAT PLAYER</text><text class="brand-subtitle">PERSONAL CONVERTER</text></view></view><view class="online-state"><view class="online-dot"></view><text>{{apiConfigured ? '在线' : '未连接'}}</text></view></view>
  <view class="hero entrance entrance-2"><text class="hero-overline">SMART FILE WORKSPACE</text><view class="hero-title">让每一次转换<br/><text class="hero-highlight">都清晰可控</text></view><text class="hero-caption">文档、音频与视频，在一个轻盈的工作台里完成。</text></view>
  <view class="dashboard-panel entrance entrance-3"><view class="panel-top"><view><text class="panel-label">本周工作概览</text><text class="panel-heading">你的效率正在上升</text></view><view class="trend-badge">+ 24.8%</view></view><view class="stats-row"><view class="stat-cell"><text class="stat-number">{{file ? '01' : '00'}}</text><text class="stat-label">当前文件</text></view><view class="stat-cell"><text class="stat-number">99<text class="stat-unit">%</text></text><text class="stat-label">服务可用率</text></view><view class="stat-cell"><text class="stat-number">30<text class="stat-unit">d</text></text><text class="stat-label">链接有效期</text></view></view><view class="mini-chart"><view class="chart-line chart-line-a"></view><view class="chart-line chart-line-b"></view><view class="chart-point point-one"></view><view class="chart-point point-two"></view><view class="chart-point point-three"></view><text class="chart-caption">最近 7 天处理趋势</text><text class="chart-end">稳定运行</text></view></view>
  <view class="section-head entrance entrance-4"><view><text class="section-eyebrow">01 / WORKFLOW</text><text class="section-title">选择转换类型</text></view><text class="section-meta">{{mode === 'document' ? 'DOCUMENT' : 'MEDIA'}}</text></view>
  <view class="mode-grid entrance entrance-4"><view class="mode-tile {{mode === 'document' ? 'mode-active' : ''}}" data-mode="document" bindtap="chooseMode" hover-class="is-pressed" hover-stay-time="120"><view class="mode-icon icon-doc">D</view><view class="mode-info"><text class="mode-name">文档转 PDF</text><text class="mode-desc">报告 · 合同 · 资料</text></view><view class="mode-check">{{mode === 'document' ? '✓' : '＋'}}</view></view><view class="mode-tile {{mode === 'media' ? 'mode-active' : ''}}" data-mode="media" bindtap="chooseMode" hover-class="is-pressed" hover-stay-time="120"><view class="mode-icon icon-media">▶</view><view class="mode-info"><text class="mode-name">音视频转码</text><text class="mode-desc">播放 · 分享 · 归档</text></view><view class="mode-check">{{mode === 'media' ? '✓' : '＋'}}</view></view></view>
  <view class="workspace-card entrance entrance-5"><view class="section-head card-head"><view><text class="section-eyebrow">02 / SOURCE FILE</text><text class="section-title">准备你的文件</text></view><text class="file-limit">MAX 1 GB</text></view><view wx:if="{{!file}}" class="file-drop" bindtap="chooseFile" hover-class="is-pressed" hover-stay-time="140"><view class="drop-graphic"><view class="drop-ring"></view><view class="drop-plus">＋</view></view><view class="drop-copy"><text class="drop-title">选择微信文件</text><text class="drop-subtitle">支持普通音视频和 MFLAC / NCM 文件</text><view class="format-tags"><text>{{mode === 'document' ? 'DOC / DOCX' : 'MFLAC / NCM'}}</text><text>{{mode === 'document' ? 'TXT / ODT' : 'MP3 / WAV'}}</text></view></view><view class="drop-arrow">↗</view></view><block wx:else><view class="selected-file" hover-class="is-pressed" hover-stay-time="100"><view class="selected-icon">{{mode === 'document' ? 'DOC' : 'MEDIA'}}</view><view class="selected-copy"><text class="selected-name">{{file.name}}</text><text class="selected-size">{{file.sizeText}} · 已准备转换</text></view><button class="remove-file" bindtap="clearFile" hover-class="is-pressed" hover-stay-time="100" aria-label="移除文件">×</button></view><view class="filename-block"><view class="format-label"><text>输出文件名</text><text>{{mode === 'document' ? '自动添加 .pdf' : '自动添加输出格式'}}</text></view><input class="filename-input" value="{{outputName}}" maxlength="120" placeholder="输入输出文件名" bindinput="changeOutputName" confirm-type="done"/><text wx:if="{{outputNameError}}" class="filename-error">{{outputNameError}}</text></view></block><view wx:if="{{mode === 'media'}}" class="format-block"><view class="format-label"><text>输出格式</text><text>支持 MFLAC / NCM 解密后转码</text></view><picker mode="selector" range="{{formats}}" value="{{targetIndex}}" bindchange="changeFormat"><view class="format-select" hover-class="is-pressed" hover-stay-time="100"><view class="format-name"><view class="format-status"></view><text>{{formats[targetIndex]}}</text></view><text class="select-chevron">⌄</text></view></picker></view><view wx:if="{{uploading}}" class="progress-card"><view class="progress-row"><view><text class="progress-title">正在处理文件</text><text class="progress-note">大文件上传可能需要较长时间，请保持页面打开</text></view><text class="progress-value">{{progress}}%</text></view><progress percent="{{progress}}" stroke-width="5" activeColor="#38c7b1" backgroundColor="#dfe9e7" /><button class="cancel-button" bindtap="cancelUpload" hover-class="is-pressed" hover-stay-time="110"><text class="cancel-icon">×</text><text>取消处理</text></button></view><button wx:if="{{!uploading}}" class="convert-button {{!file ? 'button-muted' : ''}}" bindtap="startConversion" disabled="{{!file}}" hover-class="is-pressed" hover-stay-time="140"><view><text class="convert-label">{{file ? '开始转换' : '先选择文件'}}</text><text class="convert-note">{{file ? 'START CONVERSION' : 'SELECT A FILE TO CONTINUE'}}</text></view><text class="convert-arrow">→</text></button></view>
  <view wx:if="{{result}}" class="result-card entrance entrance-6">
    <view class="result-head"><view><text class="section-eyebrow">03 / COMPLETE</text><text class="section-title light-title">文件已就绪</text></view><view class="ready-tag">✓ READY</view></view>
    <view class="result-file"><view class="result-icon">✓</view><view class="selected-copy"><text class="selected-name result-name">{{result.filename}}</text><text class="selected-size result-size">链接有效 {{result.expiresText}}</text></view></view>
    <block wx:if="{{resultTempPath}}">
      <block wx:if="{{savedPath}}"><view class="result-actions"><button class="result-primary result-half" bindtap="openResult"><text>打开已保存文件</text><text class="result-arrow">↗</text></button><button class="result-secondary result-half" bindtap="deleteSavedResult">删除本地文件</button></view><text class="saved-note">已保存到小程序文件，可重复打开</text></block>
      <block wx:elif="{{resultKind === 'pdf'}}"><view class="result-actions"><button class="result-primary result-half" bindtap="openResult"><text>预览 PDF</text><text class="result-arrow">↗</text></button><button class="result-secondary result-half" bindtap="saveResult">保存到小程序文件</button></view></block>
      <block wx:else><video wx:if="{{resultKind === 'video'}}" class="media-preview" src="{{resultTempPath}}" controls show-fullscreen-btn></video><audio wx:else class="audio-preview" src="{{resultTempPath}}" controls></audio><button class="result-secondary save-wide" bindtap="saveResult">保存到小程序文件</button></block>
    </block>
    <button wx:else class="result-primary" bindtap="openResult"><text>{{resultKind === 'pdf' ? '预览 PDF' : '下载并播放'}}</text><text>↗</text></button>
    <button wx:if="{{!result.cloud_saved}}" class="result-secondary save-wide cloud-save-button" bindtap="saveToCloud"><text>保存到云盘</text><text class="result-arrow">☁</text></button>
    <text wx:if="{{result.cloud_saved}}" class="saved-note">已保存到云盘</text>
  </view>
  </block>
  <view class="bottom-bar entrance entrance-7"><view class="nav-item {{activeTab === 'workspace' ? 'nav-current' : ''}}" data-tab="workspace" bindtap="switchTab" hover-class="is-pressed" hover-stay-time="100"><image class="nav-icon" src="/assets/nav/workspace.png" mode="aspectFit"/><text>工作台</text></view><view class="nav-item {{activeTab === 'history' ? 'nav-current' : ''}}" data-tab="history" bindtap="switchTab" hover-class="is-pressed" hover-stay-time="100"><image class="nav-icon" src="/assets/nav/history.png" mode="aspectFit"/><text>记录</text></view><view class="nav-center" data-tab="workspace" bindtap="switchTab" hover-class="is-pressed" hover-stay-time="100">+</view><view class="nav-item {{activeTab === 'help' ? 'nav-current' : ''}}" data-tab="help" bindtap="switchTab" hover-class="is-pressed" hover-stay-time="100"><image class="nav-icon" src="/assets/nav/help.png" mode="aspectFit"/><text>帮助</text></view><view class="nav-item {{activeTab === 'profile' ? 'nav-current' : ''}}" data-tab="profile" bindtap="switchTab" hover-class="is-pressed" hover-stay-time="100"><image class="nav-icon" src="/assets/nav/profile.png" mode="aspectFit"/><text>我的</text></view></view>
  <view wx:if="{{activeTab === 'history'}}" class="tab-panel entrance"><view class="tab-panel-head"><text class="tab-eyebrow">HISTORY</text><text class="tab-title">最近处理</text><text class="tab-subtitle">点击记录展开详情</text></view><view wx:if="{{historyLoading}}" class="empty-hint">正在读取最近 30 天记录…</view><block wx:elif="{{!historyFiles.length}}"><view class="empty-hint">当前设备无云端记录</view><button class="retry-button" bindtap="loadHistory">重新读取</button></block><view wx:else class="history-list"><view wx:for="{{historyFiles}}" wx:key="id" class="history-item history-item-expandable" data-id="{{item.id}}" bindtap="toggleHistoryItem" hover-class="is-pressed" hover-stay-time="100"><view class="history-icon {{item.status === 'failed' ? 'history-failed-icon' : ''}}">{{item.status === 'failed' ? 'ERR' : (item.media_type === 'application/pdf' ? 'PDF' : 'FILE')}}</view><view class="history-copy"><text class="history-filename">{{item.filename}}</text><text>{{item.status === 'failed' ? '转换失败 · 点击查看日志' : item.size_text + ' · ' + item.created_text}}</text></view><text class="history-chevron">{{expandedHistoryId === item.id ? '⌃' : '⌄'}}</text><button wx:if="{{item.cloud_saved}}" class="history-delete-button" data-id="{{item.id}}" catchtap="deleteHistoryFile">删除</button><view wx:if="{{expandedHistoryId === item.id}}" class="history-detail" catchtap="noop"><block wx:if="{{item.status === 'failed'}}"><text class="history-error-label">转换失败日志</text><text class="history-error-log">{{item.error_message || '服务未返回具体错误，请查看服务器日志。'}}</text></block><block wx:else><text class="history-expanded-name">{{item.filename}}</text><view class="history-detail-actions"><button class="history-open-button" data-url="{{item.download_url}}" data-filename="{{item.filename}}" catchtap="openHistoryFile">打开文件</button><button wx:if="{{!item.cloud_saved}}" class="history-cloud-button" data-id="{{item.id}}" data-filename="{{item.filename}}" catchtap="saveHistoryToCloud">保存到云端</button><text wx:else class="history-cloud-saved">已保存到云端</text></view></block></view></view></view></view>
  <view wx:if="{{activeTab === 'help'}}" class="tab-panel entrance"><view class="tab-panel-head"><text class="tab-eyebrow">HELP CENTER</text><text class="tab-title">需要一点帮助？</text><text class="tab-subtitle">常见问题和使用提示</text></view><view class="help-item"><view class="help-number">01</view><view><text>如何选择文件？</text><text>点击工作台里的文件区域，从微信聊天文件中选择。</text></view></view><view class="help-item"><view class="help-number">02</view><view><text>转换链接有效多久？</text><text>每个结果链接默认有效 30 天，过期后可重新转换。</text></view></view><view class="help-item"><view class="help-number">03</view><view><text>支持哪些格式？</text><text>文档支持 DOC、DOCX、ODT、RTF、TXT，媒体支持常见音视频格式。</text></view></view></view>
  <view wx:if="{{activeTab === 'profile'}}" class="tab-panel entrance"><view class="profile-card"><view class="profile-avatar">W</view><text class="profile-title">个人工作台</text><text class="profile-subtitle">当前设备用户 · {{clientId}}</text></view><view class="profile-row"><text>接口状态</text><text class="profile-value">{{apiConfigured ? '已连接' : '待配置'}}</text></view><view class="profile-row"><text>单次上传上限</text><text class="profile-value">1 GB</text></view><view class="profile-row"><text>云端保留记录</text><text class="profile-value">未保存结果 30 天，云盘文件手动删除</text></view><text class="profile-section-title">云端文件</text><view wx:if="{{cloudLoading}}" class="empty-hint">正在读取云盘…</view><block wx:elif="{{!cloudFiles.length}}"><view class="empty-hint">还没有保存到云盘的文件</view></block><view wx:else class="history-list"><view wx:for="{{cloudFiles}}" wx:key="id" class="history-item saved-file-item"><view class="history-icon media-history">FILE</view><view class="history-copy" data-url="{{item.download_url}}" data-filename="{{item.filename}}" bindtap="openHistoryFile"><text>{{item.filename}}</text><text>{{item.size_text}} · {{item.created_text}}</text><block wx:if="{{renamingCloudId === item.id}}"><input class="rename-input" value="{{renameName}}" maxlength="120" bindinput="changeRenameName"/><view class="rename-actions"><button data-id="{{item.id}}" catchtap="confirmRenameCloud">确认</button><button catchtap="cancelRenameCloud">取消</button></view></block></view><block wx:if="{{renamingCloudId !== item.id}}"><button class="cloud-rename-button" data-id="{{item.id}}" data-filename="{{item.filename}}" catchtap="startRenameCloud">重命名</button></block><button class="saved-delete-button" data-id="{{item.id}}" catchtap="deleteHistoryFile">删除</button></view></view><text class="profile-section-title">小程序文件</text><view wx:if="{{!savedFiles.length}}" class="empty-hint">还没有保存到本地的小程序文件</view><view wx:else class="history-list"><view wx:for="{{savedFiles}}" wx:key="filePath" class="history-item saved-file-item"><view class="history-icon media-history">FILE</view><view class="history-copy" data-path="{{item.filePath}}" data-filename="{{item.filename}}" bindtap="openSavedFile"><text>{{item.filename}}</text><text>{{item.sizeText}} · {{item.createdText}}</text></view><button class="saved-delete-button" data-path="{{item.filePath}}" catchtap="deleteSavedFile">删除</button></view></view></view>
  <view class="privacy-note"><view class="privacy-dot">✦</view><text>文件仅用于当前任务，链接过期后自动失效</text></view><view wx:if="{{!apiConfigured}}" class="config-notice"><text class="notice-mark">!</text><text>配置 API 域名后即可开始转换</text></view>
</view>

